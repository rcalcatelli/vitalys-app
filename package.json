{
  "name": "vitalys-app",
  "private": true,
  "version": "1.0.0",
  "description": "Tooling de formato y pre-commit para el monorepo Vitalys (no contiene código de aplicación).",
  "scripts": {
    "dev": "npm run dev --workspaces",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,json,css}": "prettier --write",
    "*.{json,yml,yaml}": "prettier --write"
  }
}
