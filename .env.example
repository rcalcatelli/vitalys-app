# Copiar este archivo a ".env" (mismo directorio) y completar los valores.
# ".env" esta en .gitignore: nunca se commitea. Ver
# docs/03-despliegue/entorno-local-docker.md para la guia completa de este entorno.

# ---------------------------------------------------------------------------
# Base de datos (servicio "postgres" del docker-compose.yml)
# ---------------------------------------------------------------------------

# Nombre de la base, usuario y password del Postgres que crea el propio docker-compose.
# No son las credenciales de Supabase (esas son solo para produccion, ver
# docs/03-despliegue/runbook-deploy.md) - aca elegis cualquier valor para tu entorno local.
DB_NAME=vitalys
DB_USERNAME=vitalys
DB_PASSWORD=cambiar-esta-password-local

# Puerto del HOST donde queda expuesto Postgres (util si ya tenes otro Postgres corriendo
# en el 5432 local). Dentro de la red de Docker el backend siempre usa el 5432 interno.
DB_PORT_HOST=5433

# ---------------------------------------------------------------------------
# Backend (servicio "backend" del docker-compose.yml)
# ---------------------------------------------------------------------------

# Perfil de Spring a activar. "dev" es el pensado para este flujo local.
SPRING_PROFILES_ACTIVE=dev

# Puerto del HOST donde queda expuesta la API (GET http://localhost:8080/api/health).
BACKEND_PORT_HOST=8080

# Secreto de firma de los JWT. En local puede ser cualquier cadena larga y aleatoria,
# por ejemplo generada con: openssl rand -base64 48
# NUNCA reutilizar el mismo valor que en produccion (Render).
JWT_SECRET=cambiar-por-un-secreto-aleatorio-largo

# Vigencia del token en milisegundos (86400000 = 24 h). Opcional, tiene default.
JWT_EXPIRATION_MS=86400000
