sequenceDiagram
    participant FE as Frontend (socio)
    participant TS as TurnoService
    participant MS as Morosidad
    participant DB as PostgreSQL

    FE->>TS: POST /api/turnos/gym<br/>{día y franja}
    TS->>TS: anticipación<br/>1 h a 7 días (RN-18)
    TS->>MS: veredicto(persona)
    MS->>DB: períodos y<br/>cuotas pagadas
    MS-->>TS: impagos, umbral,<br/>excepción vigente
    alt suspendido sin excepción
        TS-->>FE: 422 morosidad (RN-01)
    else puede reservar
        TS->>DB: INSERT turno GYM
        Note over DB: trigger con lock<br/>por franja: grilla,<br/>feriados, cupo,<br/>un turno por día.<br/>EXCLUDE: sin<br/>superposición
        alt la base rechaza
            DB-->>TS: error de restricción
            TS-->>FE: 409 / 422 con mensaje
        else aceptado
            TS->>DB: INSERT notificación<br/>(misma transacción)
            TS-->>FE: 201 Created
            Note over TS: después del commit:<br/>email por Brevo<br/>(1 reintento)
        end
    end
